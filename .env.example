# Quantum Trade Pro — environment configuration (copy to .env)
# cp .env.example .env   # then fill the values

# --- Security ---------------------------------------------------------------
# Required in production: protects ALL mutating endpoints (header X-API-Key).
ADMIN_API_KEY=

# Required if you connect a broker: encrypts broker API secrets at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Server -----------------------------------------------------------------
PORT=8000

# --- Rate limiting (LOT H) ---------------------------------------------------
RATE_LIMIT_PER_MINUTE=1200
RATE_LIMIT_MUTATIONS_PER_MINUTE=300
RATE_LIMIT_WINDOW_S=60

# --- Logging -----------------------------------------------------------------
# JSON structured logs (rotating, NDJSON)
LOG_FILE=data/trading_bot.jsonl
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- WebSocket ---------------------------------------------------------------
HEARTBEAT_INTERVAL_S=15

# --- Trading guards ----------------------------------------------------------
# Allow automated trading on DELAYED (non-realtime) data sources (Yahoo).
# Default false — scalping on delayed data is blocked. Use only for swing experiments.
ALLOW_DELAYED_DATA_TRADING=false

# --- Broker (REAL mode) ------------------------------------------------------
BROKER_SANDBOX=false
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_API_PASSPHRASE=

# --- Notifications -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
