# Quantum Trade Pro — environment configuration (copy to .env)
# cp .env.example .env   # then fill the values

# --- Security ---------------------------------------------------------------
# Required in production: protects ALL mutating endpoints (header X-API-Key
# or HttpOnly cookie qtp_session from POST /api/login).
ADMIN_API_KEY=
SESSION_TTL_S=43200
AUTH_MAX_FAILURES=8
AUTH_LOCKOUT_S=300
# Optional extra HMAC material for session cookies (falls back to FERNET_KEY).
# SESSION_SIGNING_KEY=

# Required if you connect a broker: encrypts broker API secrets at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Server -----------------------------------------------------------------
PORT=8000
# APP_ENV=development|test|production — in production the app refuses to
# start when ADMIN_API_KEY or FERNET_KEY is missing or manifestly weak.
APP_ENV=development

# --- Rate limiting (LOT H) ---------------------------------------------------
RATE_LIMIT_PER_MINUTE=1200
RATE_LIMIT_MUTATIONS_PER_MINUTE=300
RATE_LIMIT_WINDOW_S=60

# --- Logging -----------------------------------------------------------------
# JSON structured logs (rotating, NDJSON)
LOG_FILE=data/trading_bot.jsonl
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- WebSocket ---------------------------------------------------------------
HEARTBEAT_INTERVAL_S=15

# --- Optional realtime tradfi data ------------------------------------------
# Providers are activated only when their key is present. Each has an isolated
# rate limiter; Yahoo Finance remains the no-key delayed fallback.
# v2.8: Alpha Vantage (free key, 25 req/day, 5 req/min) is tried first for
# US equities and forex — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# --- Trading guards ----------------------------------------------------------
# Runtime guards are persisted through POST /api/settings:
#   news_unavailable_policy=block_tradfi_only (default) | block_all | allow_all
#   news_window_mode=trade (default) | avoid | ignore
#     trade  = take setups 30m before / 60m after important High-impact events
#     avoid  = historical block on the same window
#     ignore = never block on the calendar window (outage policy still applies)
#   persist_runtime_state=true — remember START/ARM until the operator stops
#   allow_delayed_data_trading=false (default)
#   auto_start_on_startup=false / auto_arm_on_startup=false (never auto-arms REAL)
# Delayed Yahoo data stays blocked for automated scalping unless explicitly opted out.
ALLOW_DELAYED_DATA_TRADING=false

# --- Broker (REAL mode) ------------------------------------------------------
BROKER_SANDBOX=false
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_API_PASSPHRASE=

# --- Notifications -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
